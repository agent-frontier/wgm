# wgm runtime artifacts — generated when the skill is dogfooded inside this repo.
# The repo ships *templates* (assets/*.template.*), never live plans/specs/scenarios,
# so these root paths should never be committed by accident.
/.wgm/
/STOP
/IMPLEMENTATION_PLAN.md
/specs/
/scenarios/

# Smith runtime state, journals, generated art, and validation output.
/.smith/
/docs/diary/
/docs/img/
/check-output.log

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Release artifacts built by .github/workflows/release.yml and scripts/build-release-index.sh.
/dist/
